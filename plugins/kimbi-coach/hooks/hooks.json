{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/check_updates.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\check_updates.py\"",
            "timeout": 120,
            "statusMessage": "Checking Kimbi Coach updates"
          }
        ]
      }
    ]
  }
}
